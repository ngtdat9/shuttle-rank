APP_ENV=development
# Local: SQLite. Production: Supabase session-pooler string, e.g.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# postgres:// and postgresql:// are normalized to the psycopg driver automatically.
DATABASE_URL=sqlite:///./badminton.db
# Comma-separated exact origins. Production: the Vercel URL, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# dev is local only. Production must use AUTH_MODE=supabase.
AUTH_MODE=dev
DEV_ADMIN_TOKEN=change-me-dev-token

# Project URL. Set the legacy JWT secret for HS256, or leave it empty to use JWKS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated

# Optional. Startup upserts this active admin when both values are set.
ADMIN_BOOTSTRAP_USER_ID=
ADMIN_BOOTSTRAP_EMAIL=
