# Public API base. No secrets.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Supabase Auth, public values only. Leave both blank for dev-token sign-in.
# Never put the service-role key, JWT secret, or database URL in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# supabase | dev
# dev: login shows a "Development token" field labelled DEV ONLY and stores it in sessionStorage.
# supabase: email and password via the anon key. Used by default when URL and anon key are both set.
# Explicit "dev" always wins, including when Supabase values are present.
NEXT_PUBLIC_AUTH_MODE=dev
